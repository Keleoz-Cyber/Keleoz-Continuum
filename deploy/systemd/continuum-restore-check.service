[Unit]
Description=Verify the latest Keleoz Continuum backup in an isolated database
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/keleoz-continuum
Environment=COMPOSE_FILE=compose.prod.yml
ExecStart=/usr/bin/docker compose --env-file deploy/production.env --profile maintenance run --rm --no-deps backup pnpm backup:verify
