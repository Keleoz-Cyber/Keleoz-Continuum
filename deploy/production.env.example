# Copy to deploy/production.env on the server. Never commit that real file.
POSTGRES_PASSWORD=replace-with-a-long-random-password
SESSION_SECRET=replace-with-at-least-32-random-characters
SITE_ORIGIN=https://keleoz.com
# Existing host HTTPS proxy: preserve the public Host and proxy to this local port.
# Confirm the actual proxy topology over SSH before applying; keep existing DNS/TLS.
CONTINUUM_HTTP_BIND=127.0.0.1
CONTINUUM_HTTP_PORT=8080
CONTINUUM_IMAGE_TAG=local
NPM_REGISTRY=https://registry.npmjs.org/

# Optional direct TLS only: add -f compose.https.yml after -f compose.prod.yml.
# Set absolute paths to existing PEM files; no certificate issuance/renewal is installed.
# CONTINUUM_TLS_CERT_FILE=
# CONTINUUM_TLS_KEY_FILE=
# CONTINUUM_TLS_BIND=0.0.0.0
# CONTINUUM_TLS_HTTP_PORT=80
# CONTINUUM_HTTPS_PORT=443

MEDIA_DRIVER=local
MEDIA_LIGHTCOS_BUCKET=
MEDIA_LIGHTCOS_SECRET_ID=
MEDIA_LIGHTCOS_SECRET_KEY=
MEDIA_PUBLIC_ORIGIN=

AI_GATEWAY_ENABLED=false
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=deepseek-v4-flash-vision-exp
AI_COMPANION_NAME=Keleoz
# Output budgets include reasoning tokens; keep the provider's default thinking.
AI_TEA_MAX_OUTPUT_TOKENS=2048
AI_TEA_MAX_REQUESTS_PER_SESSION=12
AI_TEA_MAX_REQUESTS_PER_SOURCE_DAY=20
AI_TEA_COOLDOWN_SECONDS=3
AI_STORY_MAX_OUTPUT_TOKENS=4096
AI_STORY_DOCUMENT_MAX_OUTPUT_TOKENS=8192
AI_STORY_MAX_REQUESTS_PER_SESSION=20
AI_STORY_MAX_REQUESTS_PER_SOURCE_DAY=30
AI_STORY_COOLDOWN_SECONDS=1
AI_STORY_DOCUMENT_TIMEOUT_MS=90000
AI_TAROT_MAX_OUTPUT_TOKENS=2048
AI_TAROT_MAX_REQUESTS_PER_SESSION=4
AI_TAROT_MAX_REQUESTS_PER_SOURCE_DAY=20
AI_TAROT_COOLDOWN_SECONDS=1
AI_PERSONA_MAX_OUTPUT_TOKENS=2048
AI_CHAT_MAX_OUTPUT_TOKENS=4096
AI_CHAT_MAX_REQUESTS_PER_THREAD=200
AI_CHAT_MAX_REQUESTS_PER_OWNER_DAY=500
AI_GLOBAL_MAX_CONCURRENCY=2
AI_TIMEOUT_MS=90000
# Configure provider credentials, current rates and an approved budget before enabling.
AI_DAILY_BUDGET_MICRO_USD=0
AI_INPUT_MICRO_USD_PER_MILLION_TOKENS=0
AI_OUTPUT_MICRO_USD_PER_MILLION_TOKENS=0
