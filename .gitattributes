# Normalize new project text files.
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.css text eol=lf

# Explicit binary assets.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.avif binary
*.ico binary
*.woff binary
*.woff2 binary
*.br binary
*.gz binary

# Preserve the upstream license bytes recorded in the font provenance manifest.
public/fonts/*-OFL.txt -text -whitespace

# This rule must stay last so extension rules cannot normalize evidence files.
upstream/** -text
